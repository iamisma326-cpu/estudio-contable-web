{
  "name": "estudio-contable-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"try{require('vite')}catch(e){process.exit(1)}\" || npm install",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:comprobante": "node --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-comprobante.ts",
    "test:asientos": "node --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-asientos.ts",
    "test:xml": "node --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-xml.ts",
    "test:moneda": "node --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-moneda.ts",
    "test:ingesta": "node --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-ingesta.ts",
    "test:persistencia": "node --env-file=.env --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-persistencia.ts",
    "test:api": "node --env-file=.env --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-api-comprobantes.ts",
    "test": "npm run test:comprobante && npm run test:asientos && npm run test:xml && npm run test:moneda && npm run test:ingesta && npm run test:pdf && npm run test:ple && npm run test:igv && npm run test:excel",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "db:seed-admin": "node --env-file=.env scripts/seed-admin.mjs",
    "test:clientes": "node --env-file=.env --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-api-clientes.ts",
    "test:pdf": "node --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-pdf.ts",
    "test:ple": "node --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-ple.ts",
    "test:ple-api": "node --env-file=.env --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-api-ple.ts",
    "test:igv": "node --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-igv.ts",
    "test:liquidacion": "node --env-file=.env --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-api-liquidacion.ts",
    "test:excel": "node --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-excel.ts",
    "test:libro": "node --env-file=.env --experimental-strip-types --import ./scripts/_resolver-ts.mjs scripts/test-api-libro.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@gsap/react": "^2.1.2",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@neondatabase/serverless": "^1.2.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.15",
    "lucide-react": "^0.546.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
